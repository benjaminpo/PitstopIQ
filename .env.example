# Fuel Finder (UK GOV) — copy to .env.local and fill in
FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=
FUEL_FINDER_BASE_URL=https://www.fuel-finder.service.gov.uk
# Required for CSV primary path: Fuel Finder portal transport key
# (NEXT_PUBLIC_SECRET_KEY from their SPA). Without it, live loads fall back to the JSON API.
FUEL_FINDER_TRANSPORT_SECRET=

# User accounts (Better Auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Absolute app origin (required in production / CI builds)
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated account emails allowed to access /admin
ADMIN_EMAILS=admin@example.com
# Production: Neon pooled URL — set on Vercel (not usually in local .env).
# When unset locally, a SQLite file (pitstopiq.db) is used.
# DATABASE_URL=postgresql://user:pass@ep-….aws.neon.tech/neondb?sslmode=require

# Google AdSense (optional monetization)
# Publisher ID from AdSense → Account → Account information (ca-pub-… or pub-…)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional: create a Display ad unit and paste its slot ID for the sidebar
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Google Analytics 4 (optional) — Measurement ID looks like G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# UK vehicle registration lookup (Vehicle presets → Find by registration)
# DVLA Vehicle Enquiry Service — https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=
# Set true to hit the DVLA UAT/test endpoint instead of production
# DVLA_USE_TEST_ENV=true
# Optional: DVSA MOT History (adds model name) — https://documentation.history.mot.api.gov.uk/
MOT_HISTORY_API_KEY=
MOT_HISTORY_CLIENT_ID=
MOT_HISTORY_CLIENT_SECRET=
MOT_HISTORY_TOKEN_URL=
MOT_HISTORY_SCOPE=
# Demo fixtures without keys (default on in development)
# VEHICLE_LOOKUP_ALLOW_MOCKS=true
